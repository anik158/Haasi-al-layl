<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarms through SCHEDULE_EXACT_ALARM on every version, not USE_EXACT_ALARM. Play
         reserves USE_EXACT_ALARM for alarm-clock and calendar apps and rejects others; a prayer
         app is not reliably accepted. SCHEDULE_EXACT_ALARM is user-granted (denied by default for
         new installs on Android 14+), so Today shows a one-tap card to allow it, Settings'
         reliability panel has a Fix row, and BootAndTimeChangeReceiver re-arms when it changes.
         Without it the scheduler falls back to a one-minute window. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The prayer alert is an alarm, not a notice: it opens a screen over the lock screen and
         rings until it is stopped. A full-screen intent is the only sanctioned way to do that
         from a background broadcast, since background activity launches were blocked in
         Android 10. Android 14 narrowed this permission to calling and alarm apps, which is what
         this is - but PrayerNotificationManager.canUseFullScreenAlarm still asks before relying
         on it, and falls back to an audible notification when the answer is no. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Turning the screen on for a Fajr alarm. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- So Settings' reliability panel can offer a single "Allow" rather than sending the user to
         find this app in a list of every installed one. Play restricts this permission to a short
         list of permitted use cases; "alarms or reminders as the app's core functionality" is one,
         and is what this app is. OEM power managers
         that ignore the direct dialog fall back to the full list. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <application
        android:name=".HaasiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Haasi">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Haasi.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!--
          The alarm screen. singleInstance so a second prayer firing mid-ring lands in the one
          that is already up rather than stacking; excludeFromRecents because a spent alarm has
          no business in the recents list. No intent-filter and not exported: it is only ever
          reached through this app's own full-screen intent.
        -->
        <activity
            android:name=".PrayerAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Haasi.Alarm" />

        <!-- No intent-filter: always invoked by an explicit Intent, so a filter would be pure
             attack surface. -->
        <receiver
            android:name=".data.notification.PrayerAlarmReceiver"
            android:exported="false" />

        <!-- Silences a ringing alarm from its notification. Explicit intents only. -->
        <receiver
            android:name=".data.notification.AlarmStopReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.notification.BootAndTimeChangeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
